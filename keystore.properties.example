# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is git-ignored and must never be committed.
#
# The upload key has to be the same one every earlier release was signed with,
# otherwise Google Play rejects the upload. Check which key a keystore holds:
#
#   keytool -list -v -keystore <path to your .jks>
#
# The SHA1 shown there must match the fingerprint the Play Console names in
# its error message when a bundle is signed with the wrong key.

storeFile=C:/path/to/your/upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
