<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- The scrolling behaviour keeps this below the app bar, including the
         status bar inset the app bar consumes. The window insets at the bottom
         and the sides are applied as padding in MainActivity. -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Timestamp Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/timestamp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/timestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="datetime" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Auto Update Input -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/autoUpdateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/autoUpdate"
                    android:labelFor="@+id/autoUpdateSwitch"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="1dp"
                    android:layout_toStartOf="@+id/autoUpdateSwitch" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoUpdateSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />

            </RelativeLayout>

            <!-- URL Template Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/urlTemplate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/urlTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- EVSE Id Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/evseId">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/evseId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shared Secret Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/sharedSecret">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sharedSecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Validity Time Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/validityTime">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/validityTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- TOTP Length Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/totpLength">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/totpLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Alphabet Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/alphabet">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alphabet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Resulting URL Field -->
            <TextView
                android:id="@+id/resultingURL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="@string/resultingURLPlaceholder"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:textColor="?attr/colorPrimary"
                android:textAlignment="center" />

            <!-- Remaining Time Field -->
            <TextView
                android:id="@+id/remainingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="@string/remainingTimePlaceholder"
                android:textSize="16sp"
                android:textColor="?attr/colorPrimary"
                android:textAlignment="center" />

            <!-- Verdict of the last scan, filled in by MainActivity -->
            <TextView
                android:id="@+id/scanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:visibility="gone"
                tools:text="TOTP valid — current time slot"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/scannedURL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:textSize="13sp"
                android:textIsSelectable="true"
                android:textAlignment="center"
                android:visibility="gone"
                tools:text="https://charging.cloud/DE*GEF*E12345*678*1/CN63y502maVh"
                tools:visibility="visible" />

            <!-- Scan QR Code Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:padding="8dp"
                android:textSize="19sp"
                android:text="@string/scanQRCode"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
