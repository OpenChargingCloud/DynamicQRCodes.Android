<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- The scrolling behaviour keeps this below the app bar, including the
         status bar inset the app bar consumes. The window insets at the bottom
         and the sides are applied as padding in MainActivity. -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Timestamp Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/timestamp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/timestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="datetime" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Use Device Time Input -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/useDeviceTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/useDeviceTime"
                    android:labelFor="@+id/useDeviceTimeSwitch"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_toStartOf="@+id/useDeviceTimeSwitch" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/useDeviceTimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />

            </RelativeLayout>

            <!-- URL Template Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/urlTemplate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/urlTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- EVSE Id Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/evseId">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/evseId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shared Secret Input. The one field here that is actually a
                 secret, so it is masked, with Material's own eye button to
                 reveal it - which is needed often, because this is the value
                 somebody has to carry over to the CSMS by hand.

                 Kept out of autofill: it looks like a password to the
                 framework but belongs to a charging station rather than to an
                 account, and a password manager offering to save it would be
                 both useless and slightly alarming. -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/sharedSecret"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sharedSecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Validity Time Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/validityTime">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/validityTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- TOTP Length Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/totpLength">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/totpLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Alphabet Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/alphabet">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alphabet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Everything the app produces, in one group under one
                 heading. Loose views on the page background read as more of
                 the form above them; a filled card says "this is the answer,
                 not another thing to fill in". Inside it the order a driver
                 meets things: the code on the charging station, the URL it
                 carries, then how much longer that URL holds.

                 The QR code and the divider under it disappear together when
                 the input goes invalid - MainActivity puts the error message
                 where the URL was, and a stale code above an error message
                 would be the one thing worse than no code. -->
            <TextView
                android:id="@+id/generatedURLHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="4dp"
                android:text="@string/generatedURL"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/resultCard"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/qrCode"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:layout_gravity="center_horizontal"
                        android:padding="10dp"
                        android:background="@drawable/qr_code_background"
                        android:contentDescription="@string/qrCodeDescription"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/qrCodeDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Not selectable any more: a long press copies the whole
                         URL, and text selection would claim that same gesture
                         for itself. -->
                    <TextView
                        android:id="@+id/resultingURL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/resultingURLPlaceholder"
                        android:textSize="16sp"
                        android:textColor="?attr/colorPrimary"
                        android:textAlignment="center" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />

                    <!-- Remaining validity: the label, a bar that empties as
                         the time slot runs out, and below it the seconds. -->
                    <TextView
                        android:id="@+id/remainingValidityLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/remainingValidity"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textAlignment="center" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/remainingValidityBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"
                        tools:progress="70" />

                    <TextView
                        android:id="@+id/remainingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:textColor="?attr/colorPrimary"
                        android:textAlignment="center"
                        tools:text="7 s" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Verdict of the last scan, filled in by MainActivity -->
            <TextView
                android:id="@+id/scanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:visibility="gone"
                tools:text="TOTP valid — current time slot"
                tools:visibility="visible" />

            <!-- Which EVSE the scanned code belongs to; information, not a verdict -->
            <TextView
                android:id="@+id/scannedEvseId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp"
                android:textSize="14sp"
                android:textAlignment="center"
                android:visibility="gone"
                tools:text="EVSE ID: DE*GEF*E12345*678*2 (differs from the configured one)"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/scannedURL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:textSize="13sp"
                android:textIsSelectable="true"
                android:textAlignment="center"
                android:visibility="gone"
                tools:text="https://charging.cloud/DE*GEF*E12345*678*1/CN63y502maVh"
                tools:visibility="visible" />

            <!-- Scan QR Code Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:padding="8dp"
                android:textSize="19sp"
                android:text="@string/scanQRCode"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart" />


            <!-- Which build is running on this device, filled in by MainActivity.
                 Deliberately below the readable-body-text size: this is a
                 de-emphasised diagnostic label, and a long press copies it. -->
            <TextView
                android:id="@+id/buildInfo"
                tools:ignore="SmallSp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textSize="10sp"
                android:alpha="0.6"
                android:textAlignment="center"
                tools:text="1.3 (4) · 5a61d10 · installed 2026-08-23 07:55" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
