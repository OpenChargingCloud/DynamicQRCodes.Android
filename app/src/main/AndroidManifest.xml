<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Scanning is a convenience; generating URLs works without a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Nothing here about backup: the app keeps nothing between launches. Every
         value on screen is either typed in, derived from the clock, or a shared
         secret generated fresh at start, so there is nothing to include or
         exclude - and allowBackup has been deprecated since Android 12 anyway,
         which is this app's minimum. -->
    <application
        android:name=".MyApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DynamicQRCodes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DynamicQRCodes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No screenOrientation: the scanner follows the device, which is what
             Android 17 enforces on large screens anyway. -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.DynamicQRCodes.Scanner" />

    </application>

</manifest>
